{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phonepilot-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "durable_objects": {
    "bindings": [
      { "name": "DAILY_LIMIT", "class_name": "DailyLimitCounter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DailyLimitCounter"] }
  ],
  "ratelimits": [
    {
      "name": "DEVICE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
